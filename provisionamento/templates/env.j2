# {{ ansible_managed }}
#
# 🔴 GERADO PELO PLAYBOOK. Editar à mão perde na próxima execução.
#
# Este arquivo é a ÚNICA fonte de configuração de execução: o painel o lê pelo
# framework e os processos de chamada o leem por `getenv` em config/dialer.php e
# config/fastagi.php, com bootstrap mínimo (ADR-0001). Um segundo lugar com os
# mesmos números divergiria na primeira mudança.

APP_NAME=Prospecta
APP_ENV=production

# 🔴 FIXO por instância, vindo de host_vars. Gerar a cada execução do playbook
# invalidaria toda sessão e todo valor cifrado no banco a cada implantação — o
# operador seria deslogado e as credenciais de fornecedor ficariam ilegíveis.
# Gere UMA vez: php artisan key:generate --show
APP_KEY={{ app_key }}

APP_DEBUG=false
APP_URL={{ 'https' if https_ativo | bool else 'http' }}://{{ dominio }}

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR
APP_TIMEZONE={{ fuso_horario | default('America/Sao_Paulo') }}

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning

# ---- Banco ----------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE={{ banco_nome }}
DB_USERNAME={{ banco_usuario }}
DB_PASSWORD={{ banco_senha }}

# ---- Sessão e cache -------------------------------------------------------
# Nas tabelas, não em Redis: uma VPS por cliente não justifica outro serviço.
SESSION_DRIVER=database
SESSION_LIFETIME=480
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# 🔴 Segue o HTTPS, e não é opcional. `true` sobre HTTP faz o navegador não
# enviar o cookie: o login parece funcionar e volta ao formulário indefinidamente,
# sem erro em log nenhum. Ver `https_ativo` em group_vars/all.yml.
SESSION_SECURE_COOKIE={{ 'true' if https_ativo | bool else 'false' }}

CACHE_STORE=database

# 🔴 `sync`, e a migration de `jobs` NÃO existe (ver database/migrations/README).
#
# O ADR-0002 decidiu que Ação é linha em tabela, nunca requisição dentro da
# chamada, então nada no produto despacha job. `sync` é a escolha honesta: se
# algum código passar a despachar, ele roda inline e falha alto. Com `database`
# falharia por tabela ausente, e a mensagem apontaria para o lugar errado.
QUEUE_CONNECTION=sync

FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log

# Não há mail configurado, e é deliberado: sem redefinição de senha por e-mail
# (ver App\Livewire\Entrar), não há para onde enviar.
MAIL_MAILER=log

# ---- AMI, usado pelo dialer ------------------------------------------------
AMI_HOST=127.0.0.1
AMI_PORT=5038
AMI_USER={{ ami_usuario }}
AMI_SECRET={{ ami_segredo }}

# ---- Discagem --------------------------------------------------------------
# Canais CONTRATADOS: é o teto do produto, e o dialer o respeita. A Campanha pode
# pedir menos, nunca mais.
#
# 🔴 É O TETO DA INSTÂNCIA, e passou a ser de verdade em 26/08/2026. Antes ele era
# aplicado POR CAMPANHA — com três no ar, o produto segurava três vezes isso do
# tronco. Se você conhece este arquivo de antes, o número mudou de significado.
PROSPECTA_CANAIS={{ canais_contratados }}

# 0 desliga o teto de chamadas por segundo. Só existe para rota que reclama de
# rajada; a malha fechada já limita pelo número de canais.
PROSPECTA_CPS_MAXIMO={{ cps_maximo | default(0) }}

PROSPECTA_INTERVALO_SEG={{ intervalo_seg | default('1.0') }}

# Eventos do AMI drenados por volta do dialer.
#
# 🔴 O DEFAULT ERA 200, E ERA O GARGALO. Medido em 26/08/2026 numa instância com
# três Campanhas: o dialer batia no teto 47 vezes em 6 minutos e gastava a volta
# DRENANDO em vez de originar. Subindo para 2000, a vazão passou de 3,0 para 7,8
# chamadas por segundo e as simultâneas de 58 para 152 — sem tocar em canais nem em
# CPS, que tinham folga o tempo todo.
#
# O teto existe para o laço não ficar preso drenando num PBX movimentado; o que
# estava errado era o VALOR, não a ideia. Com `Events: on` o Asterisk manda todo
# evento da máquina, e 200 não cobre nem um punhado de chamadas simultâneas.
PROSPECTA_EVENTOS_POR_VOLTA={{ eventos_por_volta | default(2000) }}

# Teto de tentativas para Ligação sem mapa em memória — o caso de evento chegando
# depois de um reinício do dialer. O valor que vale é `campanha.max_tentativas`.
PROSPECTA_MAX_TENTATIVAS={{ max_tentativas_padrao | default(3) }}

# Depois disto a reconciliação encerra a Ligação como presa E DEVOLVE O LEAD À FILA.
#
# 🔴 TEM QUE SER MAIOR QUE A CHAMADA MAIS LONGA POSSÍVEL. A varredura só tem o tempo
# como prova de que o evento de AMI se perdeu — chamada viva que passa daqui é declarada
# morta, o canal é dado como livre e o Lead é discado DE NOVO, para quem está na linha
# naquele instante. O painel recusa Campanha cujo pior caso passe deste número, e a conta
# está em `App\Dominio\DuracaoMaxima`.
PROSPECTA_LIMITE_LIGACAO_SEG={{ limite_ligacao_seg | default(300) }}

# Quanto deixamos chamando antes do NOSSO CANCEL. O 487 medido nesta rota é o nosso
# cancelamento, não desistência da operadora — então este número define a ocupação de
# canal do não atendido. Entra na conta da duração máxima, porque `iniciada_em` é de
# antes de originar: a janela da reconciliação começa a correr no toque.
PROSPECTA_TIMEOUT_TOQUE_SEG={{ timeout_toque_seg | default(28) }}

# 🔴 A ROTA SAIU DO AMBIENTE. Host, credencial, from_domain e prefixo técnico vivem em
# `configuracao.rota_*` e são editados na tela Rota do painel — o dialer os lê a cada volta.
# Havia aqui `PROSPECTA_TRONCO` e `PROSPECTA_TECH_PREFIX`; manter as duas seria manter uma
# segunda fonte para o mesmo fato, e o prefixo é seleção de capacidade: errar não dá erro,
# dá Campanha sem resposta.
PROSPECTA_CONTEXTO=prospecta-saida

# ---- Worker (remetente de Ação) --------------------------------------------
PROSPECTA_WORKER_LOTE={{ worker_lote | default(20) }}

# 🔴 TETO BAIXO de propósito. A Cloud API não tem chave de idempotência: uma
# retentativa depois de timeout PODE enviar a mesma mensagem duas vezes, e o Lead
# recebe duas enquanto o cliente paga duas. Ver App\Worker\PoliticaDeEnvio.
PROSPECTA_WORKER_MAX_TENTATIVAS={{ worker_max_tentativas | default(3) }}

# Eventos do WEBHOOK por volta. Chave própria: a PROSPECTA_EVENTOS_POR_VOLTA é do
# dialer e conta eventos do AMI, que é outro volume.
PROSPECTA_WORKER_EVENTOS_POR_VOLTA={{ worker_eventos_por_volta | default(100) }}

PROSPECTA_WORKER_INTERVALO_SEG={{ worker_intervalo_seg | default(5) }}

# Espera quando o CANAL está quebrado — token inválido, aplicativo sem permissão.
# Longo porque só ação humana resolve, e insistir a cada 5 s encheria o log.
PROSPECTA_WORKER_PAUSA_SEG={{ worker_pausa_seg | default(300) }}

PROSPECTA_WORKER_TIMEOUT_SEG={{ worker_timeout_seg | default(15) }}

# ---- Gravação --------------------------------------------------------------
PROSPECTA_GRAVACAO_DIR={{ gravacao_dir }}
PROSPECTA_GRAVACAO_RETENCAO_DIAS={{ gravacao_retencao_dias }}
# Caminho ABSOLUTO. O prefixo que o Asterisk usa no Playback é derivado do
# basename — uma fonte só, ver config/fastagi.php.
PROSPECTA_AUDIO_PATH={{ audio_dir }}

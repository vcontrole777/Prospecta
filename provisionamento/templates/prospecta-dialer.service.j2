[Unit]
Description=Prospecta dialer
Documentation=https://github.com/vcontrole777/Prospecta/issues/11
After=mysql.service asterisk.service
Wants=mysql.service asterisk.service

[Service]
# Serviço PERSISTENTE, não cron.
# O ADR-0005 trocou o ritmo de malha aberta (taxa calculada, distribuída
# por minuto) para malha FECHADA: conta canal livre real a cada volta.
# Taxa realimentada quer processo contínuo.
#
# Efeito colateral: o systemd garante instância única, então a trava de
# arquivo que um cron exigiria deixa de ser necessária.
ExecStart=/usr/bin/php{{ php_versao }} {{ app_dir }}/bin/dialer.php
Restart=always
RestartSec=5

User={{ app_usuario }}
Group={{ app_usuario }}

# 🔴 SEM `Environment=PROSPECTA_CANAIS`. Havia um aqui, repetindo o `.env`.
#
# O `bootstrap/ambiente.php` dá precedência ao ambiente sobre o arquivo, então a
# cópia da unidade VENCIA. Subindo de 60 para 150, o `.env` mudou, o dialer
# reiniciou ANTES do bloco das unidades — ainda com a unidade velha — e o bloco só
# fez `daemon-reload`. Resultado: `.env` dizendo 150, dialer discando com 60, e
# nada em log apontando a divergência além do "canais":60 da partida.
#
# O `.env` é a fonte única (ver o cabeçalho de templates/env.j2).

[Install]
WantedBy=multi-user.target
